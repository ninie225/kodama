{% extends 'base.html.twig' %}
{% block title %}Erreur 404{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/error.css') }}">
{% endblock %}

{% block body %}
<div class="error-page d-flex flex-column min-vh-100">
    {% include 'navbar.html.twig' %}

    <div class="flex-grow-1 d-flex flex-column justify-content-center align-items-center text-center text-white px-3">
        <p class="h5">Quel dommage, cette page n'existe pas.</p>
        <p class="h5">Totoro vous tiendra compagnie pendant que vous réfléchissez à la suite..</p>
        <h1 class="display-3">404</h1>
    </div>
</div>
{% endblock %}

